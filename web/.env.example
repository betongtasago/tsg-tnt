# ===== TSG-TNT - bien moi truong mau =====
# Sao chep file nay thanh .env roi dien gia tri that.

# --- Database (PostgreSQL) ---
# Local:  postgresql://tsg_app:PASSWORD@127.0.0.1:5432/tsg_tnt?schema=public
# Neon:   postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/tsg_tnt?sslmode=require
DATABASE_URL="postgresql://tsg_app:CHANGE_ME@127.0.0.1:5432/tsg_tnt?schema=public"

# --- Bao mat ---
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="thay-bang-chuoi-ngau-nhien-toi-thieu-32-ky-tu"
# Khoa ma hoa AES-256-GCM cho RTSP URL + Telegram token (base64, dung 32 byte)
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="thay-bang-base64-cua-32-byte"

# --- AI Camera Agent ---
AGENT_API_TOKEN="thay-bang-token-agent"

# --- Tuy chon ---
NEXT_PUBLIC_APP_NAME="TSG-TNT"
TZ="Asia/Ho_Chi_Minh"
